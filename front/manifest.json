{
  "manifest_version": 3,
  "name": "Email Spam & Phishing Detector",
  "version": "1.0",
  "description": "Scans opened emails in Gmail and flags potential spam or phishing risk using a local AI model.",
  "permissions": [],
  "host_permissions": [
    "https://mail.google.com/*",
    "http://127.0.0.1:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "alert.css"
      ]
    }
  ]
}